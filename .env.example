# Required for all deployments. Set these in Vercel project settings, NOT GitHub.
APP_PASSWORD=replace-with-unique-random-password-at-least-16-characters
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
# Use a NEW dedicated Supabase project, then apply supabase-schema.sql.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-new-server-only-sb-secret-key
