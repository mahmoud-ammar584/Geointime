# Owner-only authentication; keep your existing values.
APP_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_OF_AT_LEAST_16_CHARACTERS
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Pulled by neon deploy / neon env pull. Server-only, never NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AWS_ACCESS_KEY_ID=REPLACE_WITH_NEON_BRANCH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NEON_BRANCH_SECRET
AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH_STORAGE_ENDPOINT
AWS_REGION=REPLACE_WITH_PROJECT_REGION
